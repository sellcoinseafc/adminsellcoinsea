# Server
PORT=3211
ALLOWED_ORIGINS=https://samicoins.com,https://www.samicoins.com

# AES-256-GCM application secret
# Use a long random secret; never commit the real value.
ENCRYPTION_KEY=

# Preferred Firebase Admin credentials.
# FIREBASE_PRIVATE_KEY may contain literal \\n sequences.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# VPS-only fallback is also supported:
# server/services/serviceAccountKey.json
# Keep the real key file outside Git and protected by .gitignore.

# Security hardening
# Prefer Firebase UIDs for the highest-privilege decrypt permission.
# If UIDs are empty, the two configured emails below are used.
DECRYPT_ADMIN_EMAILS=mt.samicoins@gmail.com,psnsa7@gmail.com
DECRYPT_ADMIN_UIDS=

# Set when Node runs behind a trusted reverse proxy (for example Nginx).
TRUST_PROXY=

# Enable only when the public site is served exclusively over HTTPS.
ENABLE_HSTS=true
