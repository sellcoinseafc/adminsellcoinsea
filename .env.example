# Server
PORT=3211
ALLOWED_ORIGINS=https://samicoins.com,https://www.samicoins.com

# AES-256-GCM application secret
# Use a long random secret; never commit the real value.
ENCRYPTION_KEY=

# Preferred Firebase Admin credentials.
# FIREBASE_PRIVATE_KEY may contain literal \\n sequences.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# VPS-only fallback is also supported:
# server/services/serviceAccountKey.json
# Keep the real key file outside Git and protected by .gitignore.
