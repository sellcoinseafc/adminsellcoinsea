rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active != false;
    }

    // Public order form reads only the published settings document.
    match /system/settings {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Numbering/reservation is server-only. Firebase client SDKs never write it.
    match /system/orderNumbering {
      allow read, write: if false;
    }

    match /orderReferences/{referenceNumber} {
      allow read, write: if false;
    }

    // Customer order creation, updates and deletion are server-side only.
    // Admin dashboard may read orders; mutations stay behind protected APIs.
    match /orders/{orderId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Admin identity documents are readable only to authenticated admins.
    // Client-side writes remain disabled so role/active fields cannot be escalated.
    match /admins/{uid} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Audit history may be read by admins; entries are immutable from the browser.
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    match /whatsappLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Reviews are managed by the admin dashboard.
    match /reviews/{reviewId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
