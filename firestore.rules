rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active != false;
    }

    // Public settings are readable, but all mutations are server-authoritative.
    match /system/settings {
      allow read: if true;
      allow write: if false;
    }

    // Numbering/reservation is server-only. Firebase client SDKs never write it.
    match /system/orderNumbering {
      allow read, write: if false;
    }

    match /orderReferences/{referenceNumber} {
      allow read, write: if false;
    }

    // Customer order creation, updates and deletion are server-side only.
    // Admin dashboard may read orders; mutations stay behind protected APIs.
    match /orders/{orderId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Admin identity documents are readable only to authenticated admins.
    // Client-side writes remain disabled so role/active fields cannot be escalated.
    match /admins/{uid} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Audit history is server-authored; the browser is read-only.
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /whatsappLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Review records are server-authored. Admins can read them through the dashboard.
    match /reviews/{reviewId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Only approved, non-sensitive review cards are public.
    // The server creates/removes these mirror documents.
    match /publicReviews/{reviewId} {
      allow read: if true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
