            <h4 id="modalTitle" style="font-size: 1.05rem; font-weight: 900; margin-bottom: 10px; color: var(--text-color);">--</h4>
            <div id="modalBodyContent" style="font-size: 0.85rem; color: var(--text-color); line-height: 1.6;"></div>
        </div>
    </div>

    <footer>
        <div class="footer-links">
            <a href="#" onclick="showSupportModal(); return false;">دعم فني</a><span>•</span>
            <a href="#" onclick="showPrivacyModal(); return false;">الخصوصية</a><span>•</span>
            <a href="#" onclick="showTermsModal(); return false;">الشروط</a>
        </div>
        <p>جميع الحقوق محفوظة سامي كوينز © 2026</p>
    </footer>

